# Turso Database Configuration
# - Lokal Dev: file:shrimpcashier-dev.db (tanpa token)
# - Cloud Prod: libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL="file:shrimpcashier-dev.db"
TURSO_AUTH_TOKEN=""

# Auth & Session Security
SESSION_SECRET="your-32-character-session-secret-goes-here"

# Super Admin Default Credentials
DEFAULT_SUPERADMIN_USERNAME="spradmcsr"
DEFAULT_SUPERADMIN_PASSWORD="shrimpcashier406"
